# Expo / React Native — not started by Docker Compose.
# Copy: cp .env.example .env

# Production API (release builds; also baked into app.config extra via EAS env)
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# Optional: logical env for extra.environment (development | preview | production)
# EAS profiles set EXPO_PUBLIC_APP_ENV; local dev can omit.
# EXPO_PUBLIC_APP_ENV=development

# Development: full URL to API (use machine LAN IP + nginx port when API is in Docker)
# Example: http://192.168.1.10:80  (same as school-erp-infra HTTP_PORT)
EXPO_PUBLIC_BACKEND_URL_DEV=http://localhost:80

# Or build dev URL from IP + port:
EXPO_PUBLIC_LOCAL_IP=192.168.1.100
EXPO_PUBLIC_DEV_PORT=80

# Optional: a school-specific build (its own Play Store listing) bakes its
# tenant in so the app knows its school before anyone signs in. Leave both
# unset for the general Nexchool app — that is what every default below is
# for. Setting only one of EXPO_PUBLIC_APP_NAME/_SLUG/_ICON/_SCHEME/
# EXPO_PUBLIC_ANDROID_PACKAGE without the tenant vars renames the app but
# does not bake in a school; see app.config.ts.
#
# Either identifier alone is enough — prefer the subdomain, which you can
# check by eye. A mistyped UUID points a school's whole app at another school
# and nothing about it looks wrong.
#
# Note that release builds do NOT read this file: EAS builds and updates take
# these from the EAS environment variables instead (`eas env:list production`).
# See PLAY_STORE_RELEASE_GUIDE.md.
# EXPO_PUBLIC_TENANT_SUBDOMAIN=yourschool
# EXPO_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional: app identity overrides for a school-specific build. Each defaults
# to today's Nexchool value, so leaving all of these unset is unchanged.
# EXPO_PUBLIC_APP_NAME=Your School
# EXPO_PUBLIC_APP_SLUG=your-school
# EXPO_PUBLIC_APP_ICON=./assets/icon.png
# EXPO_PUBLIC_APP_SCHEME=yourschool
# EXPO_PUBLIC_ANDROID_PACKAGE=in.nexchool.yourschool
